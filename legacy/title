#!/bin/bash
## Shortcut to search, add, and play an title (after clearing current playlist).
## Use -a (for "add") to add the title to the playlist without clearing current playlist.
source /etc/myscripts/colors.sh
if [[ -z $1 ]] ; then
	echo "You must specify a song"
	exit
fi
#help
if [[ $1 = -h || $1 = --help ]] ; then
	echo "USAGE: song [OPTION] [SONG NAME]"
	echo "Queue song to MPD"
	echo ""
	echo "   -a		add"
	echo "   -i		insert"
	echo "   -xa		exact add"
	echo "   -xi		exact insert"
	echo "   -x		exact"
	echo "   -h, --help	Display this message and exit"

        exit
fi

#add
if [[ $1 = -a ]] ; then
	shift
	if [[ -z $* ]] ; then
        	echo "You must specify a song"
        	exit
	fi

	mpc search title "$*" | grep -v "_loved" | mpc add ; mpc play
	mpc-playlist -s
	mpc-status
	exit
fi

#insert
if [[ $1 = -i ]] ; then
	shift
	if [[ -z $* ]] ; then
        	echo "You must specify a song"
        	exit
	fi
	mpc search title "$*" | grep -v "_loved" | mpc insert ; mpc play
	mpc-playlist -s
	mpc-status
	exit
fi

#exact add
if [[ $1 = -xa || $1 = -ax ]] ; then
        shift
	if [[ -z $* ]] ; then
        	echo "You must specify a song"
        	exit
	fi
	IFS=$(echo -en "\n\b")
        _out=$(mpc -q find title "$*")
        if [ ! -z "$_out" ] ; then
                mpc -q findadd title "$*"
                mpc-playlist -s
                mpc-status
        else
#                _suggest=($(mpc list title | grep -i "$*"))
#                for i in ${!_suggest[@]}; do
#                        _suggest_artist[i]=$(mpc find title "${_suggest[i]}" | sed 's|_Kims/||' | sed 's|/|\t|g' | cut -d $'\t' -f2 | sort -u | perl -p -e 's/\n/ OR /' | sed 's| OR $|\n|')
#                done
                for f in $(mpc list title | grep -i "$*"); do
                        _aa=$(mpc find title "$f" | sed 's|_Kims/||' | sed 's|/|\t|g' | cut -d $'\t' -f1,2 | sort -u)
			if [ $(wc -l <<< "$_aa") -gt 1 ] ; then
				_a1=$(grep -v "Various Artists" <<< "$_aa")
				if [[ ! -z "$_a1" ]] ; then
					_aa="$_a1"
				fi
			fi
                        if grep -q "^_" <<< "$_aa" ; then
                                _aa=$(echo "$_aa" | sed -r "s/.+/Various Artists\t$f/")
                        else
                                _aa=$(echo "$_aa" | cut -d $'\t' -f2 | sed "s/\$/\t$f/")
                        fi
                        _suggest+=($(echo "$_aa" | cut -d $'\t' -f2))
                        _suggest_artist+=($(echo "$_aa" | cut -d $'\t' -f1))
                done
                _length=${#_suggest[@]}
                menu() {
                        echo -e $red"Nothing Found!"$yellow"\nDid you mean?"$reset
                        for i in ${!_suggest[@]}; do
                                printf "%3d%s) %s\n" $((i+1)) "${choices[i]:- }" $ltblue"${_suggest[i]}$reset by $cyan${_suggest_artist[i]}"$reset
                        done
                        [[ "$msg" ]] && echo "$msg"; :
                }

                prompt=$yellow"Check a selection (again to uncheck, ENTER when done): "$reset
                while menu && read -rp "$prompt" num && [[ "$num" ]]; do
                        [[ "$num" != *[![:digit:]]* ]] &&
                                (( num > 0 && num <= ${#_suggest[@]} )) ||
                                { msg=$red"Invalid option: $num"$reset; continue; }
                                ((num--)); msg=$cyan"${_suggest[num]} was ${choices[num]:+un}checked"$reset
                        [[ "${choices[num]}" ]] && choices[num]="" || choices[num]="+"
                done
                _c=""
                for i in ${!_suggest[@]}; do
                        [[ "${choices[i]}" ]] && _c="1" ;
                done
                if [ ! -z $_c ] ; then
                        for i in ${!_suggest[@]}; do
                                [[ "${choices[i]}" ]] && mpc findadd title "${_suggest[i]}"
                        done
			mpc -q play
                        mpc-playlist -s
                        mpc-status
                else
                        echo -e $red"\nYou selected nothing.\n"$reset
                fi
        fi
	exit
fi

