#!/bin/bash
source /etc/myscripts/colors.sh
if [[ $1 = -p ]] ; then
	_FILEPATH="/storage/dd1/mp3/$(mpc current -f %file%)"
	_PATH=$(dirname "$_FILEPATH")
	_MPDPATH=$(echo "$_PATH" | sed 's|/storage/dd1/mp3/||')

elif [[ $1 = -all ]];then
	read -p "You are about to run this tool on the entire mp3 library. Are you sure? " -n 1 -r
		echo    # (optional) move to a new line
	if [[ ! $REPLY =~ ^[Yy]$ ]]
	then
    		exit 1
	fi
	cd /storage/dd1/mp3
	find . -iname *.mp3 -print0 | while IFS= read -r -d '' file
	do
    		/etc/myscripts/mpd/apewipe "$file" | grep "No APE tag found"
        	/etc/myscripts/mpd/apetag --delete "$file"
                _UPDATED=1
                echo "Converting..."
                eyeD3 "$file" --no-color --encoding=utf16 --to-v2.3 | grep -q "Writing ID3 version v2.3"
                eyeD3 "$file" --no-color --remove-v1
                echo "$file"
		if [ $? -eq 0 ];then
	                echo $red"Tag not written"$reset
			echo "$file" >> /tmp/tagfix
                fi
	done
	exit
else
	[ "$1" ] && _PATH="$1" || _PATH=$PWD
fi
_UPDATED=0
echo "Seed Path is: ""$_FILEPATH"
echo "Path is: ""$_PATH"
echo "MPD Path is: ""$_MPDPATH"
cd "$_PATH"
read -p "Are you sure? " -n 1 -r
echo    # (optional) move to a new line
if [[ ! $REPLY =~ ^[Yy]$ ]]
then
    exit 1
fi
for file in *.mp3; do
	echo "File is: ""$file"
	if [[ -r "$file" ]]; then
		/etc/myscripts/mpd/apewipe "$file"
                /etc/myscripts/mpd/apetag --delete "$file"
		_UPDATED=1
		echo "Converting..."
		eyeD3 "$file" --no-color --encoding=utf16 --to-v2.3  | grep -q "Writing ID3 version v2.3"
		eyeD3 "$file" --no-color --remove-v1
		if [ $? -eq 0 ];then
			echo $red"Tag not written"$reset
			echo "$file" >> /tmp/tagfix
		fi
	fi
done
#if [[ _UPDATED -eq 1 ]];then
#	mpc update "$_MPDPATH"
#fi
cd $OLDPWD
cat /tmp/tagfix
