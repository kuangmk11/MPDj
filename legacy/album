    			[[ "${choices[num]}" ]] && choices[num]="" || choices[num]="+"
		done
		_c=""
		for i in ${!_suggest[@]}; do
                        [[ "${choices[i]}" ]] && _c="1" ;
                done
		if [ ! -z $_c ] ; then
			mpc -q clear
			for i in ${!_suggest[@]}; do
				if [ ${_suggest_artist[i]} = "Various Artists" ] ; then
					[[ "${choices[i]}" ]] && mpc findadd album "${_suggest[i]}"
				else
	    				[[ "${choices[i]}" ]] && mpc findadd album "${_suggest[i]}" artist "${_suggest_artist[i]}"
				fi
			done
			mpc -q play
			mpc-playlist
        		mpc-status
		else
			echo -e $red"\nYou selected nothing.\n"$reset
		fi
	fi
	exit
fi



#default
mpc clear
mpc search album "$*" | grep -v "_loved" | mpc add ; mpc play
mpc-playlist
mpc-status
exit
