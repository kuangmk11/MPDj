                                if [ ${_suggest_artist[i]} = "Various Artists" ] ; then
                                        [[ "${choices[i]}" ]] && mpc find album "${_suggest[i]}" | mpc insert
                                else
                                        [[ "${choices[i]}" ]] && mpc find album "${_suggest[i]}" artist "${_suggest_artist[i]}" | mpc insert
                                fi
                        done
                        mpc -q play
                        mpc-playlist
                        mpc-status
                else
