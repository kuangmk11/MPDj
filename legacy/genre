#!/bin/bash
## Shortcut to search, add, and play an genre (after clearing current playlist).
## Use -a (for "add") to add the genre to the playlist without clearing current playlist.
source /etc/myscripts/colors.sh
if [[ -z $1 ]] ; then
        echo "You must specify a genre"
        exit
fi

if [[ $1 = -h || $1 = --help ]] ; then
        echo "USAGE: genre [OPTION] [GENRE NAME]"
        echo "Queue genre to MPD"
        echo ""
        echo "   -a             add"
        echo "   -i             insert"
        echo "   -xa            exact add"
        echo "   -xi            exact insert"
        echo "   -x             exact"
        echo "   -q             no playlist output"
        echo "   -h, --help     Display this message and exit"

        exit
fi


#add
if [[ $1 = -a ]] ; then
	shift
	if [[ -z $* ]] ; then
        	echo "You must specify a genre"
        	exit
	fi
	mpc search genre "$*" | mpc add ; mpc play
	mpc-playlist
	mpc-status
	exit
fi

#quiet
if [[ $1 = -q ]] ; then
	shift
	if [[ -z $* ]] ; then
        	echo "You must specify a genre"
        	exit
	fi
	mpc clear
	mpc search genre "$*" | mpc add ; mpc play
	exit
fi

#insert
if [[ $1 = -i ]] ; then
	shift
	if [[ -z $* ]] ; then
        	echo "You must specify a genre"
        	exit
	fi
	mpc search genre "$*" | mpc insert ; mpc play
	mpc-playlist
	mpc-status
	exit
fi

#exact add
if [[ $1 = -xa ]] || [ $1 = -ax ] ; then
        shift
	if [[ -z $* ]] ; then
        	echo "You must specify a genre"
        	exit
	fi
	IFS=$(echo -en "\n\b")
        _out=$(mpc -q find genre "$*")
        if [ ! -z "$_out" ] ; then
                mpc -q findadd genre "$*"
                mpc-playlist
                mpc-status
        else
                _suggest=($(mpc list genre | grep -i "$*"))
                _length=${#_suggest[@]}
                menu() {
                        echo -e $red"Nothing Found!"$yellow"\nDid you mean?"$reset
                        for i in ${!_suggest[@]}; do
                                printf "%3d%s) %s\n" $((i+1)) "${choices[i]:- }" "${_suggest[i]}"
                        done
                        [[ "$msg" ]] && echo "$msg"; :
                }

                prompt=$yellow"Check a selection (again to uncheck, ENTER when done): "$reset
                while menu && read -rp "$prompt" num && [[ "$num" ]]; do
                        [[ "$num" != *[![:digit:]]* ]] &&
                                (( num > 0 && num <= ${#_suggest[@]} )) ||
                                { msg=$red"Invalid option: $num"$reset; continue; }
                                ((num--)); msg=$cyan"${_suggest[num]} was ${choices[num]:+un}checked"$reset
                        [[ "${choices[num]}" ]] && choices[num]="" || choices[num]="+"
                done
                _c=""
                for i in ${!_suggest[@]}; do
                        [[ "${choices[i]}" ]] && _c="1" ;
                done
                if [ ! -z $_c ] ; then
                        for i in ${!_suggest[@]}; do
                                [[ "${choices[i]}" ]] && mpc findadd genre "${_suggest[i]}"
                        done
			mpc -q play
                        mpc-playlist
                        mpc-status
                else
                        echo -e $red"\nYou selected nothing.\n"$reset
                fi
        fi
	exit
fi

#exact insert
if [[ $1 = -xi ]] || [ $1 = -ix ] ; then
        shift
	if [[ -z $* ]] ; then
        	echo "You must specify a genre"
        	exit
	fi
	IFS=$(echo -en "\n\b")
        _out=$(mpc -q find genre "$*")
        if [ ! -z "$_out" ] ; then
                mpc -q findadd genre "$*"
                mpc-playlist
                mpc-status
        else
                _suggest=($(mpc list genre | grep -i "$*"))
                _length=${#_suggest[@]}
                menu() {
                        echo -e $red"Nothing Found!"$yellow"\nDid you mean?"$reset
                        for i in ${!_suggest[@]}; do
                                printf "%3d%s) %s\n" $((i+1)) "${choices[i]:- }" "${_suggest[i]}"
                        done
                        [[ "$msg" ]] && echo "$msg"; :
                }

                prompt=$yellow"Check a selection (again to uncheck, ENTER when done): "$reset
                while menu && read -rp "$prompt" num && [[ "$num" ]]; do
                        [[ "$num" != *[![:digit:]]* ]] &&
                                (( num > 0 && num <= ${#_suggest[@]} )) ||
                                { msg=$red"Invalid option: $num"$reset; continue; }
                                ((num--)); msg=$cyan"${_suggest[num]} was ${choices[num]:+un}checked"$reset
                        [[ "${choices[num]}" ]] && choices[num]="" || choices[num]="+"
                done
                _c=""
                for i in ${!_suggest[@]}; do
                        [[ "${choices[i]}" ]] && _c="1" ;
                done
                if [ ! -z $_c ] ; then
                        for i in ${!_suggest[@]}; do
                                [[ "${choices[i]}" ]] && mpc find genre "${_suggest[i]}" | mpc insert
                        done
                        mpc -q play
                        mpc-playlist
                        mpc-status
                else
                        echo -e $red"\nYou selected nothing.\n"$reset
                fi
        fi
	exit
fi

#exact
if [[ $1 = -x ]] ; then
	shift
	if [[ -z $* ]] ; then
        	echo "You must specify a genre"
        	exit
	fi
	IFS=$(echo -en "\n\b")
	_out=$(mpc -q find genre "$*")
	if [ ! -z "$_out" ] ; then
		mpc -q clear
		mpc -q findadd genre "$*"
		mpc -q play
		mpc-playlist
		mpc-status
	else
		_suggest=($(mpc list genre | grep -i "$*"))
		_length=${#_suggest[@]}
		menu() {
    			echo -e $red"Nothing Found!"$yellow"\nDid you mean?"$reset
    			for i in ${!_suggest[@]}; do 
        			printf "%3d%s) %s\n" $((i+1)) "${choices[i]:- }" "${_suggest[i]}"
    			done
    			[[ "$msg" ]] && echo "$msg"; :
		}

		prompt=$yellow"Check a selection (again to uncheck, ENTER when done): "$reset
		while menu && read -rp "$prompt" num && [[ "$num" ]]; do
    			[[ "$num" != *[![:digit:]]* ]] &&
    				(( num > 0 && num <= ${#_suggest[@]} )) ||
    				{ msg=$red"Invalid option: $num"$reset; continue; }
    				((num--)); msg=$cyan"${_suggest[num]} was ${choices[num]:+un}checked"$reset
    			[[ "${choices[num]}" ]] && choices[num]="" || choices[num]="+"
		done
		_c=""
		for i in ${!_suggest[@]}; do
                        [[ "${choices[i]}" ]] && _c="1" ;
                done
		if [ ! -z $_c ] ; then
			mpc -q clear
			for i in ${!_suggest[@]}; do
    				[[ "${choices[i]}" ]] && mpc findadd genre "${_suggest[i]}"
			done
			mpc -q play
			mpc-playlist
        		mpc-status
		else
			echo -e $red"\nYou selected nothing.\n"$reset
		fi
	fi
	exit
fi

#default
mpc clear
mpc search genre "$*" | mpc add ; mpc play
mpc-playlist
mpc-status
exit
