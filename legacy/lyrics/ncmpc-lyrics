#!/bin/bash
source /etc/myscripts/colors.sh
echo "$*" >> /home/ono/.ncmpc/ncmpc-lyrics.log
source /etc/myscripts/mpd/lyrics/variables
_SOURCE=""
if grep -q '^Updating DB' <<< "$_ARTIST"; then
	echo found db
	exit
fi
if grep -q "^volume:" <<< "$_ARTIST"; then
	echo found vol
	exit
fi

#don't run if ncmpc is already running
sleep 2
wait $(pgrep --exact quietlyrics) >/dev/null 2>&1

#_ART_COR_URL=$(wget -qO- "http://ws.audioscrobbler.com/2.0/?method=artist.getcorrection&artist=$_TRUEARTIST&api_key=$_API_KEY" | xml_grep '//lfm/corrections/correction/artist/name' --text_only)
#[ ! -z "$_ART_COR_URL" ] && echo "ARTIST NAME SHOULD BE: $_ART_COR_URL"

if [ -s "$_LYRFILE" ] ; then
	chmod 777 "$_LYRFILE"
	cat "$_LYRFILE"
	echo -e "\n\n\nsource:local $_LYRFILE"
	if [ -e "$_LYRPATH/bio.txt" ] ; then
               	echo ""
		echo ""
		cat "$_LYRPATH/bio.txt"
        fi
	exit 0
elif [ -s "$lrc_LYRFILE" ] ; then
        sed -E 's/^\[.+]//' "$lrc_LYRFILE"
        echo -e "\n\n\nsource:lrc"
        if [ -e "$_LYRPATH/bio.txt" ] ; then
                echo ""
                echo ""
                cat "$_LYRPATH/bio.txt"

        fi
        exit 0
else
        _LYRICS=$(wget -qO- "$_URL" | sed '/./,$!d')
	if [ "$_LYRICS" != "$_SRY" ]; then
                mkdir "$_LYRPATH" >/dev/null 2>&1
                echo "$_LYRICS" > "$_LYRFILE"
		_SOURCE="makeitpersonal.co"
                #eyeD3 --lyrics=eng:Lyrics:"$_LYRICS" "$_FILE" 1>/dev/null
	else
                rm "$_file" >> /dev/null 2>&1
                touch "$_file"
                ruby /etc/myscripts/mpd/lyrics/.support/20-lyricwiki.rb "$_ARTIST" "$_TITLE" 2> /dev/null >> "$_file"
                if [ -s "$_file" ] ; then
                        mkdir "$_LYRPATH" >> /dev/null 2>&1
			sed -i "s/&#8217;/'/" "$_file"
                        sed -i "s#<b>##" "$_file"
                        sed -i "s#<i>##" "$_file"
                        sed -i "s#</b>##" "$_file"
                        sed -i "s#</i>##" "$_file"
                        sed -i '/showAsyncAd/d' "$_file"
			cat "$_file" > "$_LYRFILE"
			#tail -n +2 "$_file" > "$_LYRFILE"
			_SOURCE="LyricsWiki"
                else
    		        bash /etc/myscripts/mpd/lyrics/metro-lyrics "$_ARTIST" "$_TITLE" 2> /dev/null >> "$_file"
			if [ -s "$_file" ] ; then
				cat "$_file" > "$_LYRFILE"
				_SOURCE="MetroLyrics"
			fi
                fi
        fi
	touch "$_LYRFILE"
	minimumsize=2
	actualsize=$(wc -c "$_LYRFILE" | cut -f 1 -d ' ')
	if [ $actualsize -ge $minimumsize ]; then
             	echo "" >> "$_LYRFILE"
        	echo "" >> "$_LYRFILE"
		echo "source:$_SOURCE" >> "$_LYRFILE"
	else
        	rm "$_LYRFILE"
	fi
	if [ -s "$_LYRFILE" ] ; then
		chmod 777 "$_LYRFILE"
	        cat "$_LYRFILE"
		if [ -e "$_LYRPATH/bio.txt" ] ; then
			echo ""
			echo ""
			cat "$_LYRPATH/bio.txt"
        	fi
		rm "$_file" > /dev/null 2>&1
		exit 0
	else
	        echo "$_ARTIST - $_TITLE" >> /var/log/lyrics.log
	        sort -u /var/log/lyrics.log -o /var/log/lyrics.log
	fi
	rm "$_file" > /dev/null 2>&1
fi
echo "No Lyrics Found"
echo ""

if [ -e "$_LYRPATH/bio.txt" ] ; then
	cat "$_LYRPATH/bio.txt"
fi
