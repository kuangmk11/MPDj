#!/bin/bash
#http://www.songtexte.com/search?q=the+cure+pictures+of+you&c=songs
source /etc/myscripts/colors.sh

_SM="http://www.songtexte.com/search?q="
if [[ $1 = -p ]] ; then
        source /etc/myscripts/mpd/lyrics/variables
        echo "using currently playing track"
else
        _ARTIST="$1"
        _TITLE="$2"
fi

_ARTIST=${_ARTIST//ü/ue}
_ARTIST=${_ARTIST//ÿ/y}

_URL="$_SM$_ARTIST $_TITLE&c=songs"
_URL=${_URL// /+}

_SEARCH=$(wget -qO- "$_URL")
if grep -q '<span class="song">' <<< "$_SEARCH" ; then
	_URL="http://www.songtexte.com/"$(grep '<span class="song">' <<< "$_SEARCH" | sed -r 's|^.+href="||' | sed -r 's|" title=".+$||')
	_SEARCH=$(wget -qO- "$_URL")
	#<a style="" class="" href="http://songmeanings.com/songs/view/3530822107858883335/" title="Winter">Winter</a>                          </td>
fi
_SEARCH=$(echo "$_SEARCH" | grep '<div id="lyrics">' | html2text 2>/dev/null )
echo "$_SEARCH"
