        menu() {
        	for i in ${!_suggest[@]}; do
                           printf "%3d%s) %s\n" $((i+1)) "${choices[i]:- }" "${_suggest[i]}"
                done
                [[ "$msg" ]] && echo "$msg"; :
       	}
        prompt=$yellow"Check a selection (again to uncheck, ENTER when done): "$reset   ###CHANGE FOR ONE SELECTION ONLY
        while menu && read -rp "$prompt" num && [[ "$num" ]]; do
		[[ "$num" != *[![:digit:]]* ]] &&
                	(( num > 0 && num <= ${#_suggest[@]} )) ||
                        { msg=$red"Invalid option: $num"$reset; continue; }
                        ((num--)); msg=$cyan"${_suggest[num]} was ${choices[num]:+un}checked"$reset
                [[ "${choices[num]}" ]] && choices[num]="" || choices[num]="+"
        done
        _c=""
        for i in ${!_suggest[@]}; do
        	[[ "${choices[i]}" ]] && _c="1" ;
        done
        if [[ ! -z $_c ]] ; then
        	for i in ${!_suggest[@]}; do
                	if [[ "${choices[i]}" ]] ; then
				nano "${_suggest[i]}"
				read -p "Do you wish to relink the default tab to this one? Y/n" -n 1 -r
				echo    # (optional) move to a new line
				if [[ $REPLY =~ ^[Yy]$ ]] ; then
    					rm "$_BTABFILE.txt" >/dev/null 2>&1
					ln -s "${_suggest[i]}" "$_BTABFILE.txt"
				fi
			fi
                done
        else
        	echo -e $red"\nYou selected nothing.\n"$reset
        fi
	exit
fi

