#!/bin/bash
source /etc/myscripts/colors.sh
#source /etc/myscripts/mpd/lyrics/variables
IFS=$(echo -en "\n\b")
_LIST=/tmp/playlist-edit$(date +%s)
#echo "$_LIST"
_header1=$green"Choose songs to remove from playlist"$reset
_header2=$yellow"If the song changes while you are editing results will be not as expected"$reset
_suggest=($(mpc playlist -f %artist%¥%album%¥%track%¥%title% | column -t -s¥))
if [ ! -z "$_suggest" ] ; then
	_length=${#_suggest[@]}
	menu() {
           for i in ${!_suggest[@]}; do
                           printf "%3d%s) %s\n" $((i+1)) "${choices[i]:- }" "${_suggest[i]}"
                done
                [[ "$msg" ]] && echo "$msg"; :
        }
        prompt=$yellow"Check a selection (again to uncheck, ENTER when done): "$reset   ###CHANGE FOR ONE SELECTION ONLY
        while clear && echo "$_header1" && echo "$_header2" && menu && read -rp "$prompt" num && [[ "$num" ]]; do
		[[ "$num" != *[![:digit:]]* ]] &&
                        (( num > 0 && num <= ${#_suggest[@]} )) ||
                        { msg=$red"Invalid option: $num"$reset; continue; }
                        ((num--)); msg=$cyan"${_suggest[num]} was ${choices[num]:+un}checked"$reset
                [[ "${choices[num]}" ]] && choices[num]="" || choices[num]="+"
        done
	_c=""
        for i in ${!_suggest[@]}; do
                [[ "${choices[i]}" ]] && _c="1" ;
        done
        if [ ! -z $_c ] ; then
		for i in ${!_suggest[@]}; do
                        if [[ "${choices[i]}" ]] ; then
				_TRACK=$(($i + 1))
				echo "mpc del ""$_TRACK" >> "$_LIST"
                        fi
                done
		sort -r "$_LIST" -o "$_LIST"
        	source "$_LIST"
		clear
        	mpc-playlist
        	mpc-status
        else
                echo -e $red"\nYou selected nothing.\n"$reset
        fi
else
	echo "String not found"
fi
rm "$_LIST" >/dev/null 2>&1
exit



