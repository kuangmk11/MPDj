#!/bin/bash
echo $(date) - $(basename $0) variables >> /var/log/mpd/mpd-ext.log
_TRUEARTIST="$(mpc current -f '%artist%')"
_ARTIST="$(mpc current -f '%artist%' | sed 's|\/|_|' | perl -ne 'print lc')"
_ALBUM="$(mpc current -f '%album%' | sed 's|\/|_|' | perl -ne 'print lc')"
