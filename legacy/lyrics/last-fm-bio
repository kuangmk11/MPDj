#!/bin/bash
source /etc/myscripts/colors.sh
source /etc/myscripts/mpd/lyrics/variables
if grep -q '^Updating DB' <<< "$_ARTIST"; then
        echo found db
        exit
fi
if grep -q "^volume:" <<< "$_ARTIST"; then
        echo found vol
        exit
fi

#xml age limit in seconds: day=86400 week=604800
oldIFS="$IFS"
_AGE_LIMIT=604800
mkdir "$_LYRPATH" >/dev/null 2>&1
#_ART_ARTIST=$(mpc current -f %file% | sed -r 's|^|/storage/dd1/mp3/|')
_PATH=$(mpc current -f %file% | sed -r 's|^|storage/dd1/mp3/|')
if grep -q '^storage/dd1/mp3/volume:' <<< "$_PATH" ; then
	echo $red"bad path, is something playing? exiting"$reset
	exit 1
fi
IFS='¥' array=(${_PATH//\//¥})
#for i in "${!array[@]}"
#do
#    echo "$i=>${array[i]}"
#done
IFS="$oldIFS"
if grep -q 'storage/dd1/mp3/_' <<< "$_PATH" ; then
        _ART_ARTIST="$(mpc current -f %artist%)"
	_ART_ARTIST=${_ART_ARTIST//&/and}
	_ART_ARTIST=${_ART_ARTIST//\'/_}
	_ART_ARTIST=${_ART_ARTIST//\"/_}
	_ART_ARTIST=${_ART_ARTIST//\./}
	_ART_ARTIST=${_ART_ARTIST//[\?\:\+\=\.\,]}

else
	_ART_ARTIST=${array[4]}
fi

#echo "$_ART_ARTIST"

#TEST BIO
if [ -e "$_BIO_PATH" ] ; then
	_XML_ARTIST_AGE=$(( ((`date +%s`) - (`date -r "$_BIO_PATH" +%s`)) ))
else
	_XML_ARTIST_AGE=$(( $_AGE_LIMIT + 1 ))
fi
if [ $_XML_ARTIST_AGE -gt $_AGE_LIMIT ]; then
	echo "Bio XML is old"
	_BIO=$(wget -qO- "$_XML_ARTIST")
	if echo "$_BIO" | grep -q '<lfm status="ok">'; then
		echo "$_BIO" > "$_BIO_PATH"
		chmod 777 "$_BIO_PATH" >/dev/null 2>&1
		echo "lastfm artist ok"
	else
		echo "last fm fail (artist)"
	fi
else
	echo "Artist XML New Enough"
	_BIO=$(cat "$_BIO_PATH")
	echo "$_BIO_PATH"
fi

#TEST ALBUM
if [ -e "$_ALB_PATH" ] ; then
	_XML_ALBUM_AGE=$(( ((`date +%s`) - (`date -r "$_ALB_PATH" +%s`)) ))
else
        _XML_ALBUM_AGE=$(( $_AGE_LIMIT + 1 ))
fi
if [ $_XML_ALBUM_AGE -gt $_AGE_LIMIT ]; then
        echo "Album XML is old"
        _ALB=$(wget -qO- "$_XML_ALBUM")
        if echo "$_ALB" | grep -q '<lfm status="ok">'; then
                echo "$_ALB" > "$_ALB_PATH"
                echo "lastfm album ok"
        else
                echo "last fm fail (album)"
        fi
else
        echo "Album XML New Enough"
        _ALB=$(cat "$_ALB_PATH")
fi

#PARSING BIO
_XML_SIMILAR_ARTISTS=$(echo "$_BIO" | xml_grep '//artist/similar/artist/name' --text_only)
_XML_TAGS=$(echo "$_BIO" | xml_grep '//artist/tags/tag/name' --text_only)
_XML_LISTENERS=$(echo "$_BIO" | xml_grep '//artist/stats/listeners' --text_only)
_XML_PLAYCOUNT=$(echo "$_BIO" | xml_grep '//artist/stats/playcount' --text_only)
_XML_CONTENT=$(echo "$_BIO" | xml_grep '//artist/bio/content' --text_only)
_XML_SUMMARY=$(echo "$_BIO" | xml_grep '//artist/bio/summary' --text_only)
#_XML_ARTIST_IMG=$(echo $_BIO | sed -n 's|.*<image size="mega">\(.*\)<streamable>.*|\1|p' | sed 's|<\/image>||g' | sed 's|\s||g')
_XML_ARTIST_IMG_ARR=($(echo $_BIO | xml_grep '//artist//image' --text_only --nb_results 5))
