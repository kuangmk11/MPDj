	if [ -z $_ADDED ] ; then
		#echo "$red	FAIL for ${_ARTIST[i]} - ${_TRACK[i]} $reset" | tee -a /tmp/FAIL
		_ADDED=$(mpc search title "${_TRACK[i]}" | tee -a "$_PLAYLIST")
