#!/bin/bash
## Shortcut to search, add, and play an title (after clearing current playlist).
## Use -a (for "add") to add the title to the playlist without clearing current playlist.
source /etc/myscripts/colors.sh

#add
if [[ $1 = -a ]] ; then
	shift
	mpc search title "$*" | mpc add ; mpc play
	mpc-playlist -s
	mpc-status
	exit
fi

#insert
if [[ $1 = -i ]] ; then
	shift
	mpc search title "$*" | mpc insert ; mpc play
	mpc-playlist -s
	mpc-status
	exit
fi

#exact add
if [[ $1 = -xa || $1 = -ax ]] ; then
        shift
	IFS=$(echo -en "\n\b")
        _out=$(mpc -q find title "$*")
        if [ ! -z "$_out" ] ; then
                mpc -q findadd title "$*"
                mpc-playlist -s
                mpc-status
        else
                _suggest=($(mpc list title | grep -i "$*"))
##########
                for i in ${!_suggest[@]}; do
                        _suggest_artist[i]=$(mpc find title "${_suggest[i]}" | sed 's|_Kims/||' | sed 's|/|\t|g' | cut -d $'\t' -f2 | sort -u | perl -p -e 's/\n/ OR /' | sed 's| OR $|\n|')
                done
###########
                _length=${#_suggest[@]}
                menu() {
                        echo -e $red"Nothing Found!"$yellow"\nDid you mean?"$reset
                        for i in ${!_suggest[@]}; do
                                printf "%3d%s) %s\n" $((i+1)) "${choices[i]:- }" $ltblue"${_suggest[i]}$reset by $cyan${_suggest_artist[i]}"$reset
                        done
                        [[ "$msg" ]] && echo "$msg"; :
                }

                prompt=$yellow"Check a selection (again to uncheck, ENTER when done): "$reset
                while menu && read -rp "$prompt" num && [[ "$num" ]]; do
                        [[ "$num" != *[![:digit:]]* ]] &&
                                (( num > 0 && num <= ${#_suggest[@]} )) ||
                                { msg=$red"Invalid option: $num"$reset; continue; }
                                ((num--)); msg=$cyan"${_suggest[num]} was ${choices[num]:+un}checked"$reset
                        [[ "${choices[num]}" ]] && choices[num]="" || choices[num]="+"
                done
                _c=""
                for i in ${!_suggest[@]}; do
                        [[ "${choices[i]}" ]] && _c="1" ;
                done
                if [ ! -z $_c ] ; then
                        for i in ${!_suggest[@]}; do
                                [[ "${choices[i]}" ]] && mpc findadd title "${_suggest[i]}"
                        done
			mpc -q play
                        mpc-playlist -s
                        mpc-status
                else
                        echo -e $red"\nYou selected nothing.\n"$reset
                fi
        fi
	exit
fi

