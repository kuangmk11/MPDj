shift
echo $gray$dim$so0ul1
mpc playlist -f "%position%>¥%artist%¥%title%¥%album%¥%track%|[%file%])"| sed "1iPOS-¥ARTIST-¥TITLE-¥ALBUM-¥##-$reset$ltblue\\" | column -t -s ¥
