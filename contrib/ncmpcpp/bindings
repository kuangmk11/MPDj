## mpdj key bindings for ncmpcpp. Append to ~/.config/ncmpcpp/bindings
## Alt+key so they don't clash with ncmpcpp's defaults.

def_key "alt-b"
  run_external_command "mpdj more best >/dev/null 2>&1"
def_key "alt-s"
  run_external_command "mpdj more similar >/dev/null 2>&1"
def_key "alt-a"
  run_external_command "mpdj more artist >/dev/null 2>&1"
def_key "alt-l"
  run_external_command "mpdj more album >/dev/null 2>&1"
def_key "alt-g"
  run_external_command "mpdj more genre >/dev/null 2>&1"
def_key "alt-r"
  run_external_command "mpdj again >/dev/null 2>&1"
def_key "alt-n"
  run_external_command "mpdj next-album >/dev/null 2>&1"
def_key "alt-p"
  run_external_command "mpdj prev-album >/dev/null 2>&1"
def_key "alt-t"
  run_external_command "mpdj trim >/dev/null 2>&1"
def_key "alt-5"
  run_external_command "mpdj rate 5 >/dev/null 2>&1"
def_key "alt-4"
  run_external_command "mpdj rate 4 >/dev/null 2>&1"
def_key "alt-3"
  run_external_command "mpdj rate 3 >/dev/null 2>&1"
def_key "alt-2"
  run_external_command "mpdj rate 2 >/dev/null 2>&1"
def_key "alt-1"
  run_external_command "mpdj rate 1 >/dev/null 2>&1"
def_key "alt-x"
  run_external_command "mpdj ban artist --purge >/dev/null 2>&1"
def_key "alt-z"
  run_external_command "mpdj ban album --purge >/dev/null 2>&1"
