#!/usr/bin/env python3
"""Restart WSLg's PulseAudio when it hangs (it does after Windows sleep/resume).

Symptom: MPD says 'failed to connect: Timeout' and there is no sound until
`wsl --shutdown`. WSLg's supervisor restarts PulseAudio when it exits, so
killing just that process brings audio back without restarting WSL.

Run every minute from a systemd user timer. Needs no sudo and no pactl.
`wslg-audio-watchdog --restart` restarts it now (for choppy sound after the screen wakes).
`wslg-audio-watchdog --full` also restarts weston, WSLg's compositor, which carries the
audio to Windows over RDP. Use it when --restart doesn't fix the stutter. It closes any
open Linux GUI windows; terminals and MPD are not affected.
"""
import socket
import struct
import subprocess
import sys
import time

SOCKET = "/mnt/wslg/PulseServer"
TIMEOUT = 3


def pulse_alive() -> bool:
    """Send a PulseAudio AUTH packet and wait for any reply."""
    # tagstruct: command AUTH (8), tag 0, protocol version 32, 256-byte cookie (ignored: auth-anonymous)
    body = (b"L" + struct.pack(">I", 8) + b"L" + struct.pack(">I", 0)
            + b"L" + struct.pack(">I", 32) + b"x" + struct.pack(">I", 256) + bytes(256))
    header = struct.pack(">IIIII", len(body), 0xFFFFFFFF, 0, 0, 0)
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(TIMEOUT)
            s.connect(SOCKET)
            s.sendall(header + body)
            return len(s.recv(20)) == 20
    except OSError:
        return False


def mpd_audio_error() -> bool:
    try:
        out = subprocess.run(["mpc", "status"], capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        return False
    return "audio output" in out or "pulse" in out.lower()


WSL = "/mnt/c/WINDOWS/system32/wsl.exe"


def system_distro(*cmd: str) -> subprocess.CompletedProcess:
    """Run a command as root in WSLg's system distro. cwd=/mnt/c keeps wsl.exe from
    complaining about a Linux working directory."""
    return subprocess.run([WSL, "--system", "-u", "root", "--", *cmd],
                          capture_output=True, timeout=30, cwd="/mnt/c")


def restart_pulse() -> None:
    system_distro("pkill", "-9", "-x", "pulseaudio")


def restart_weston() -> bool:
    """Kill weston (WSLGd starts a new one, and the RDP link to Windows with it)."""
    system_distro("pkill", "-9", "-x", "weston")
    for _ in range(15):
        time.sleep(1)
        if system_distro("pgrep", "-x", "weston").returncode == 0:
            time.sleep(2)  # let it bring up its RDP audio socket
            return True
    return False


def mpd_playing() -> bool:
    try:
        out = subprocess.run(["mpc", "status"], capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        return False
    return "[playing]" in out


def main(force: bool = False, full: bool = False) -> int:
    was_playing = mpd_playing()
    if full:
        print("restarting WSLg compositor (weston)", flush=True)
        subprocess.run(["mpc", "-q", "pause"], timeout=10)
        if not restart_weston():
            print("weston did not come back; try `wsl --shutdown` from Windows", flush=True)
            return 1
        force = True  # PulseAudio has to reconnect to the new compositor
    if not force:
        if pulse_alive():
            return 0
        time.sleep(5)  # don't act on a single slow answer
        if pulse_alive():
            return 0
        print("WSLg PulseAudio is not answering; restarting it", flush=True)
    else:
        print("restarting WSLg PulseAudio", flush=True)
    restart_pulse()
    for _ in range(10):
        time.sleep(2)
        if pulse_alive():
            break
    else:
        print("PulseAudio still not answering; try `wsl --shutdown` from Windows", flush=True)
        return 1
    if was_playing or mpd_audio_error():  # MPD pauses when its output fails: carry on playing
        if resume_mpd():
            print("audio back; resumed MPD", flush=True)
        else:
            print("audio server is back but MPD can't open it yet; try `mpc play` shortly", flush=True)
            return 1
    else:
        print("audio back", flush=True)
    return 0


def resume_mpd(tries: int = 10) -> bool:
    """PulseAudio answers before its RDP sink is ready, so MPD's first `play` can fail with
    'Failed to open audio output' and pause again. Keep trying until it stays playing."""
    for _ in range(tries):
        time.sleep(2)
        subprocess.run(["mpc", "-q", "play"], timeout=10)
        time.sleep(1)
        if mpd_playing() and not mpd_audio_error():
            return True
    return False


if __name__ == "__main__":
    if "--check" in sys.argv:
        print("alive" if pulse_alive() else "NOT answering")
        sys.exit(0)
    # --restart: e.g. choppy sound after the screen wakes. PulseAudio still answers then,
    # so the timer can't tell; restarting it fixes the sound.
    sys.exit(main(force="--restart" in sys.argv, full="--full" in sys.argv))
